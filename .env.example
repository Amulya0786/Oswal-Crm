# Local Postgres (see docker-compose.yml or README)
DATABASE_URL="postgresql://oswal:oswal@127.0.0.1:5432/oswal?schema=public"

# Session signing is the random token stored in Postgres. This secret gates cron routes.
AUTH_SECRET="change-me-in-production"
CRON_SECRET="dev-cron"

# Public URL used in feedback links
APP_URL="http://localhost:3000"

# Integration API key (header: x-api-key). Rotate in production.
OSWAL_API_KEY="oswal-demo-key"

# Show demo accounts on the login screen. The login page reads NEXT_PUBLIC_DEMO_HINTS.
# DigitalOcean sets this to 0. Leave it unset locally to keep the demo hint.
# NEXT_PUBLIC_DEMO_HINTS=0

# First admin, used only when the database has no users. The owner sets these in DigitalOcean.
# ADMIN_EMAIL=
# ADMIN_INITIAL_PASSWORD=

# Notifications. Console/log is the default. Adapters stay off until set.
NOTIFICATIONS_PROVIDER="console"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# GUPSHUP_API_KEY=
# GUPSHUP_SRC_NAME=
# GUPSHUP_SOURCE=
# MSG91_AUTH_KEY=
# MSG91_SENDER=
# SMTP_URL=
SUMMARY_EMAIL="management@oswal.test"

# Hours between escalation steps (technician -> area manager -> state head -> admin)
ESCALATION_COOLDOWN_HOURS="4"

# Set to 0 to disable the in-process scheduler (useful in tests)
ENABLE_JOBS="1"

# Smartlogics history starts on this book date (YYYY-MM-DD). Older rows are skipped.
# This is a fixed date, not a rolling year.
IMPORT_CUTOFF="2026-04-01"

# Phase 3. Leave blank to stay in mock/log mode.
# GPS_MAX_KM="15"
# SPEECH_URL=
# SPEECH_KEY=
# AI_API_KEY=
# Photos, voice notes and imports. Local disk when these are blank.
# On DigitalOcean they point at a private Space in Bangalore (blr1).
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# S3_REGION=blr1
# S3_BUCKET=oswal-service-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# STORAGE_DIR=
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# CAP_SERVER_URL=http://10.0.2.2:3000/field
