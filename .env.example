# SQLite for local development (path is relative to prisma/schema.prisma).
# For Postgres, change the datasource provider in prisma/schema.prisma to
# "postgresql" and use a URL like:
# postgresql://oswal:oswal@localhost:5432/oswal_crm?schema=public
DATABASE_URL="file:./dev.db"

# Long random string. Required for session cookies.
AUTH_SECRET="replace-with-a-long-random-string"

# Protects POST /api/jobs/escalate. Send header x-cron-secret or
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-another-long-random-string"

# Public base URL used in customer feedback links.
APP_URL="http://localhost:3000"

# Notification providers stay off until the variables they need are set.
# The desk then logs WhatsApp, SMS and email to the console and the database.
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_ID=
# GUPSHUP_API_KEY=
# GUPSHUP_SRC_NAME=
# GUPSHUP_SOURCE=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=
# SMTP_URL=
