{
  "name": "oswal-service-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/bootstrap.mjs && next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:perf": "tsx scripts/perf-seed.ts",
    "perf": "tsx scripts/perf-time.ts",
    "job:escalation": "tsx scripts/run-job.ts escalation",
    "job:summary": "tsx scripts/run-job.ts summary",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
